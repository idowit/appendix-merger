{
  "name": "Appendix Merger",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "src/App.tsx"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  },
  "updateContentCommand": "npm install",
  "postAttachCommand": {
    "server": "npm run dev -- --host 0.0.0.0"
  },
  "portsAttributes": {
    "5173": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [5173]
}
