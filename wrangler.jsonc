{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appendix-merger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
